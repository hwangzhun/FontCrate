<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FontCrate.App.App" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolVisibility" />
      <SolidColorBrush x:Key="PreviewBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="PreviewForeground" Color="#FF1F293B" />
      <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
      <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,12,0,8" />
      </Style>
      <Style x:Key="TaskLamp" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="Fill" Value="#94A3B8" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding State}" Value="Running">
            <Setter Property="Fill" Value="#2563EB" />
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Succeeded">
            <Setter Property="Fill" Value="#16A34A" />
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Warning">
            <Setter Property="Fill" Value="#F59E0B" />
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Canceled">
            <Setter Property="Fill" Value="#F59E0B" />
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Failed">
            <Setter Property="Fill" Value="#DC2626" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <DataTemplate x:Key="ProgressDialogTemplate">
        <Grid Width="520" Height="112">
          <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="24" />
            <RowDefinition Height="24" />
            <RowDefinition Height="24" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Message}" VerticalAlignment="Center" />
          <ProgressBar Grid.Row="1" Height="6" Maximum="100" Value="{Binding Value}" IsIndeterminate="{Binding Indeterminate}" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Text="{Binding Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Caption}" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Text="任务收尾完成后自动关闭，详细结果保留在任务页。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="TaskProgressTemplate">
        <Grid ToolTip="{Binding Message}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <Ellipse Style="{StaticResource TaskLamp}" AutomationProperties.Name="{Binding Message}" />
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,12,0" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="12" />
          </DockPanel>
          <ProgressBar Grid.Row="1" Maximum="100" Value="{Binding Value}" IsIndeterminate="{Binding Indeterminate}" />
          <TextBlock Grid.Row="2" Text="{Binding Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="AnnotationItemTemplate">
        <Grid ToolTip="{Binding Name}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding FaceCount}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="关联字体数量，包含来源不可用的字体" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="AnnotationPanelTemplate">
        <StackPanel>
          <StackPanel IsEnabled="{Binding Ready}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding SearchLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="4,0,4,4" />
            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SearchLabel}" AutomationProperties.Name="{Binding SearchLabel}" Padding="7,5" />
            <ListBox ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedVisibleItem, Mode=TwoWay}" ItemTemplate="{StaticResource AnnotationItemTemplate}" MinHeight="140" MaxHeight="300" AutomationProperties.Name="{Binding Title}" />
            <TextBlock Text="没有匹配项，可新建或清空搜索" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="4,5" Visibility="{Binding NoMatches, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="{Binding ActiveFilterText}" ToolTip="{Binding ActiveFilterText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="4,5" Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolVisibility}}" />
            <WrapPanel Margin="0,5,0,0">
              <ui:Button Content="新建" Command="{Binding NewCommand}" Padding="7,5" Margin="0,0,6,6" />
              <ui:Button Content="改名" Command="{Binding RenameCommand}" Padding="7,5" Margin="0,0,6,6" />
              <ui:Button Content="删除" Command="{Binding DeleteCommand}" Padding="7,5" Margin="0,0,6,6" />
            </WrapPanel>
            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="7" Padding="8" Margin="0,4,0,0" Visibility="{Binding Editing, Converter={StaticResource BoolVisibility}}">
              <StackPanel>
                <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" ToolTip="名称为 1–100 个字符" AutomationProperties.Name="{Binding EditorTitle}" Padding="7,5" />
                <WrapPanel>
                  <ui:Button Content="保存" Command="{Binding SaveCommand}" Appearance="Primary" Padding="7,5" Margin="0,0,6,6" />
                  <ui:Button Content="取消" Command="{Binding CancelCommand}" Padding="7,5" Margin="0,0,6,6" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" FontSize="11" Margin="4,4,4,0" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="正在保存…" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="4,4" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="AnnotationAssignmentTemplate">
        <StackPanel IsEnabled="{Binding Ready}">
          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" />
          <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding AssignmentItem}" DisplayMemberPath="Name" ToolTip="{Binding AssignmentLabel}" AutomationProperties.Name="{Binding AssignmentLabel}" />
          <WrapPanel>
            <ui:Button Content="添加到选中字体" Command="{Binding AddToFontsCommand}" Margin="0,0,6,6" />
            <ui:Button Content="从选中字体移除" Command="{Binding RemoveFromFontsCommand}" Margin="0,0,6,6" />
          </WrapPanel>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="NamedItemTemplate">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
