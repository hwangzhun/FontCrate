<Page ScrollViewer.CanContentScroll="False" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FontCrate.App.Views.TasksPage" Title="任务与结果" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Grid Margin="24,12,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="任务与结果" Style="{StaticResource PageTitle}" />
      <TextBlock Text="查看本次会话的最近任务和结果。任务执行时在进度弹窗中查看或取消。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ui:Card Padding="16" HorizontalContentAlignment="Stretch">
        <ContentControl Content="{Binding ScanProgress}" ContentTemplate="{StaticResource TaskProgressTemplate}" />
      </ui:Card>
      <ui:Card Grid.Column="2" Padding="16" HorizontalContentAlignment="Stretch">
        <ContentControl Content="{Binding OperationProgress}" ContentTemplate="{StaticResource TaskProgressTemplate}" />
      </ui:Card>
    </Grid>
    <WrapPanel Grid.Row="2" Margin="0,0,0,12">
      <ui:Button Content="扫描错误" Command="{Binding ShowErrorsCommand}" Margin="0,0,8,8" />
      <ui:Button Content="核对与恢复状态" Command="{Binding RecoverCommand}" Margin="0,0,8,8" />
    </WrapPanel>
    <ui:Card Grid.Row="3" Padding="16" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource Heading}" />
          <TextBlock Text="{Binding ResultState}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding ResultCounts}" Margin="0,4,0,0" TextWrapping="Wrap" />
          <ui:Button Content="{Binding ResultActionLabel}" Command="{Binding ResultActionCommand}" IsEnabled="{Binding CanManage}" Visibility="{Binding HasResultAction, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,8,0,4" />
          <TextBlock Text="{Binding ResultNote}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Expander Grid.Row="1" Header="完整结果与日志" IsExpanded="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ui:TextBox Text="{Binding ResultText, Mode=OneWay}" PlaceholderText="尚无结果。任务完成后将在这里显示。" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="最近操作结果" />
        </Expander>
      </Grid>
    </ui:Card>
  </Grid>
</Page>
