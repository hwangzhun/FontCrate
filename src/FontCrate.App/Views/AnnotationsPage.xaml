<Page ScrollViewer.CanContentScroll="False" x:Class="FontCrate.App.Views.AnnotationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:FontCrate.App.Views" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Microsoft YaHei UI" FontSize="13" Title="标签">
  <Grid Margin="24,12,24,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <ui:TextBlock Text="标签" FontTypography="Title"/>
      <ui:TextBlock Text="整理分类，在此浏览、预览和管理关联字体。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"/>
    </StackPanel>
    <ui:Card Grid.Row="1" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <views:CategoryManagementControl x:Name="TagManagement" DataContext="{Binding Tags}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </ui:Card>
  </Grid>
</Page>
