<Page ScrollViewer.CanContentScroll="False" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:FontCrate.App" x:Class="FontCrate.App.Views.SettingsPage" x:Name="SettingsRoot" Title="设置" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,12,24,24">
      <TextBlock Text="设置" Style="{StaticResource PageTitle}" Margin="0,0,0,20" />
      <ui:Card Padding="16" Margin="0,0,0,16" HorizontalContentAlignment="Stretch">
        <StackPanel>
          <TextBlock Text="外观" Style="{StaticResource Heading}" />
          <TextBlock Text="界面、字体预览及字符网格同步切换；选择自动保存。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,16" TextWrapping="Wrap" />
          <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Name" SelectedValuePath="Mode" SelectedValue="{Binding Mode, Mode=TwoWay}" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="界面主题" />
        </StackPanel>
      </ui:Card>
      <ui:Card Padding="16" Margin="0,0,0,16" HorizontalContentAlignment="Stretch">
        <StackPanel>
          <TextBlock Text="托盘与退出" Style="{StaticResource Heading}" />
          <TextBlock Text="关闭窗口时可选择完全退出或最小化到托盘。托盘运行时临时字体仍然可用；完全退出会先停用临时字体。" TextWrapping="Wrap" Margin="0,8,0,16" />
          <ui:Button Content="退出并停用临时字体" Click="Exit" HorizontalAlignment="Left" />
        </StackPanel>
      </ui:Card>
      <ui:Card Padding="16" HorizontalContentAlignment="Stretch">
        <StackPanel>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Image Source="{x:Static app:AppAssets.Logo}" Width="112" Height="112" Stretch="Uniform" VerticalAlignment="Top" AutomationProperties.Name="FontCrate logo" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="关于 FontCrate" Style="{StaticResource Heading}" />
              <TextBlock Text="{Binding VersionText, ElementName=SettingsRoot}" Margin="0,8,0,12" />
              <TextBlock Text="{Binding DescriptionText, ElementName=SettingsRoot}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding AuthorText, ElementName=SettingsRoot}" Margin="0,0,0,8" />
          <TextBlock Text="{Binding LicenseText, ElementName=SettingsRoot}" Margin="0,0,0,8" TextWrapping="Wrap" />
          <TextBlock Text="本项目使用 WPF-UI、.NET、SQLite 等开源组件，第三方许可证与声明随程序分发。" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />
          <ui:Button Content="GitHub" Icon="{ui:SymbolIcon Open24}" Click="OpenRepository" IsEnabled="{Binding HasRepository, ElementName=SettingsRoot}" HorizontalAlignment="Left" Margin="0,0,0,16" />
          <ui:CardExpander Icon="{ui:SymbolIcon Document24}" Margin="0,0,0,12" HorizontalContentAlignment="Stretch" ContentPadding="20">
            <ui:CardExpander.Header>
              <StackPanel Margin="8,0">
                <TextBlock Text="开源许可证" FontWeight="SemiBold" />
                <TextBlock Text="GNU GPL v3 · 自由使用、修改与分发" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
              </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
              <TextBlock Text="FontCrate 以 GPL-3.0-only 发布。分发程序或修改版本时，请遵守许可证并提供相应源代码。" TextWrapping="Wrap" Margin="0,0,0,16" />
              <ui:TextBox Text="{Binding ProjectLicenseText, ElementName=SettingsRoot, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="280" FontFamily="Consolas" FontSize="12" Padding="16" AutomationProperties.Name="GPL v3 开源许可证全文" />
            </StackPanel>
          </ui:CardExpander>
          <ui:CardExpander Icon="{ui:SymbolIcon Library24}" HorizontalContentAlignment="Stretch" ContentPadding="20">
            <ui:CardExpander.Header>
              <StackPanel Margin="8,0">
                <TextBlock Text="第三方开源组件" FontWeight="SemiBold" />
                <TextBlock Text="感谢这些项目 · 组件及其许可证" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
              </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
              <ItemsControl ItemsSource="{Binding ThirdPartyComponents, ElementName=SettingsRoot}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ui:Card Padding="14" Margin="0,0,0,8" HorizontalContentAlignment="Stretch">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding License}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="项目主页" Icon="{ui:SymbolIcon Open24}" Tag="{Binding Source}" Click="OpenComponent" VerticalAlignment="Center" />
                      </Grid>
                    </ui:Card>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="完整版权声明及运行时许可文件随程序一同提供。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,12" />
              <WrapPanel>
                <ui:Button Content="查看完整声明" Icon="{ui:SymbolIcon Document24}" Click="OpenThirdPartyNotices" Margin="0,0,8,0" />
                <ui:Button Content="打开许可文件夹" Icon="{ui:SymbolIcon Folder24}" Click="OpenLicenses" />
              </WrapPanel>
            </StackPanel>
          </ui:CardExpander>
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</Page>
