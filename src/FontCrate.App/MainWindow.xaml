<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FontCrate.App.MainWindow" x:Name="RootWindow" Title="FontCrate" Width="1400" Height="960" MinWidth="1050" MinHeight="700" Icon="{x:Static app:AppAssets.Logo}" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Microsoft YaHei UI" FontSize="13" xmlns:views="clr-namespace:FontCrate.App.Views" xmlns:app="clr-namespace:FontCrate.App">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="AppTitleBar" Title="FontCrate">
      <ui:TitleBar.Icon><ui:ImageIcon Source="{x:Static app:AppAssets.Logo}" /></ui:TitleBar.Icon>
    </ui:TitleBar>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
    <ui:NavigationView x:Name="Navigation" Grid.Row="0" PaneDisplayMode="Left" OpenPaneLength="200" IsBackButtonVisible="Collapsed">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="字体库" Icon="{ui:SymbolIcon TextFont24}" TargetPageType="{x:Type views:FontLibraryPage}" />
        <ui:NavigationViewItem Content="来源管理" Icon="{ui:SymbolIcon Folder24}" TargetPageType="{x:Type views:SourcesPage}" />
        <ui:NavigationViewItem Content="标签" Icon="{ui:SymbolIcon Tag24}" TargetPageType="{x:Type views:AnnotationsPage}" />
        <ui:NavigationViewItem Content="任务与结果" Icon="{ui:SymbolIcon TaskListSquareLtr24}" TargetPageType="{x:Type views:TasksPage}" />
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="{x:Static app:AppIdentity.VersionLabel}" IsEnabled="False" Focusable="False" />
        <ui:NavigationViewItem Content="设置" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type views:SettingsPage}" />
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
    <Border Grid.Row="1" Padding="16,8" Margin="16,0,16,8">
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
    </Border>
    <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="2" IsDisableSiblingsEnabled="True" Panel.ZIndex="10" />
    </Grid>
  </Grid>
</ui:FluentWindow>
